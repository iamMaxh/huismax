# Live chat bridge (bridge/server.mjs). Copy to /etc/huismax/chat-bridge.env, then:
#   sudo chown root:root /etc/huismax/chat-bridge.env && sudo chmod 600 /etc/huismax/chat-bridge.env
# systemd reads it as root before starting the bridge. Nothing in here is ever sent to Cloudflare or a browser.

# The OpenClaw gateway token. Only the bridge has it.
OPENCLAW_GATEWAY_TOKEN=
# Proves requests come from the website. The same value goes in Cloudflare → the Worker → Settings →
# Variables and Secrets → Secret CHAT_BRIDGE_SECRET. Must differ from the gateway token. Make one: openssl rand -hex 32
CHAT_BRIDGE_SECRET=

# The gateway on this machine; the bridge refuses anything but loopback. The agent is always openclaw/website.
OPENCLAW_URL=http://127.0.0.1:18789/v1/chat/completions

# Where the bridge listens: loopback, reached only by cloudflared.
HOST=127.0.0.1
PORT=8790

# Per visitor: questions a minute and a day, one answer at a time. Site-wide: answers at the same time.
RATE_PER_MINUTE=6
RATE_PER_DAY=100
MAX_CONCURRENT=4

# Keep the first-word timeout under 90 s (the chat gives up then) and 100 s (Cloudflare's limit).
FIRST_TOKEN_TIMEOUT_MS=80000
IDLE_TIMEOUT_MS=40000
MAX_DURATION_MS=180000
